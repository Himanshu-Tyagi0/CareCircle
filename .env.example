# CareCircle Environment Variables (Development template — never commit real .env)

# Execution Mode: must be explicitly set to "true" for isolated demo mode.
# Production mode ("false") fails closed if database credentials are absent.
CARECIRCLE_DEMO_MODE=false
CARECIRCLE_ENV=development

# Public base URL for confirmation links (no trailing slash)
APP_URL=http://localhost:3000

# Supabase / PostgreSQL (required in production mode)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Optional direct PostgreSQL URL for migrations/tests (never expose to client)
DATABASE_URL=

# Action Token Signing (HMAC-SHA256) — generate >=32 random bytes hex/base64
# Increment key version on rotation; keep PREVIOUS only during bounded rotation window
ACTION_SIGNING_KEY_ID=v1
ACTION_SIGNING_KEY=replace-with-at-least-32-byte-random-secret
ACTION_SIGNING_PREVIOUS_KEY_ID=
ACTION_SIGNING_PREVIOUS_KEY=
ACTION_TOKEN_MAX_TTL_SECONDS=7200

# Session & Authentication Controls
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_GLOBAL_RATE_LIMIT_PER_MIN=60
BCRYPT_ROUNDS=12

# Google Gemini AI (optional; requires explicit elder consent per circle)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gmail SMTP Notification Gateway (optional; certificate-validated TLS on 587/465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=CareCircle
SMTP_TIMEOUT_SECONDS=15

# Optional Telegram Bot API (per-member opt-in & chat binding required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEOUT_SECONDS=10

# Background Worker & Adherence Controls
WORKER_BUDGET_SECONDS=45
WORKER_BATCH_SIZE=50
WORKER_STALE_MINUTES=20
ADHERENCE_GRACE_MINUTES=30
